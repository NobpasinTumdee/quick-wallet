# Copy this file to `.env` and adjust if you need to.
# Every value here has a sane default, so `.env` is optional.

# Port the Express API listens on (the Vite dev server proxies /api to it).
PORT=4000

# Where database.xlsx lives. Relative paths resolve from the backend folder.
DB_PATH=./data/database.xlsx

# Extra origins allowed by CORS, comma separated.
# localhost:5173 / 127.0.0.1:5173 (Vite) are always allowed.
CORS_ORIGINS=

# Session token lifetime in hours.
TOKEN_TTL_HOURS=720

# Milliseconds to wait after a mutation before flushing the workbook to disk.
# Higher = fewer disk writes when you are entering data quickly.
FLUSH_DEBOUNCE_MS=300
