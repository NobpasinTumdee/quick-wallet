# Copy to `.env.local` (Vite only exposes variables prefixed with VITE_).

# --- Stock quotes -----------------------------------------------------------
# Free API key for live prices. Without one the app falls back to simulated
# quotes so the Investments screen still works — every price is then labelled
# "simulated" in the UI.
#
# Provider options: finnhub | twelvedata | mock
#   finnhub     -> https://finnhub.io/register        (free tier, CORS enabled)
#   twelvedata  -> https://twelvedata.com/pricing     (free tier, CORS enabled)
VITE_STOCK_API_PROVIDER=finnhub
VITE_STOCK_API_KEY=

# How long a quote is reused before re-fetching (seconds). Free tiers are
# rate-limited, so don't set this too low.
VITE_STOCK_CACHE_TTL=60

# Backend base URL. Leave empty to use the Vite dev proxy (recommended).
VITE_API_BASE_URL=
