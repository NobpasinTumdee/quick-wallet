# Copy to `.env.local` (Vite only exposes variables prefixed with VITE_).

# --- Backend: Google Apps Script Web App -------------------------------------
# REQUIRED. The /exec URL of your deployed Apps Script Web App.
#
# To get it:
#   1. Open your Google Sheet → Extensions → Apps Script
#   2. Paste in google-apps-script/Code.gs
#   3. Project Settings → Script Properties → add SESSION_SECRET and
#      ADMIN_SECRET (run generateSecrets() in the editor to make good ones)
#   4. Deploy → New deployment → Web app
#        Execute as:     Me
#        Who has access: Anyone      <-- required; the app has no Google login
#   5. Copy the deployment URL here. It must end in /exec.
#
# Re-deploying: use "Manage deployments → Edit → New version" to keep the same
# URL. Creating a *new* deployment issues a different URL and you must update
# this value.
VITE_GAS_WEB_APP_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXXX/exec

# --- Stock quotes -----------------------------------------------------------
# Free API key for live prices. Without one the app falls back to simulated
# quotes so the Investments screen still works — every price is then labelled
# "simulated" in the UI.
#
# Provider options: finnhub | twelvedata | mock
#   finnhub     -> https://finnhub.io/register        (free tier, CORS enabled)
#   twelvedata  -> https://twelvedata.com/pricing     (free tier, CORS enabled)
VITE_STOCK_API_PROVIDER=finnhub
VITE_STOCK_API_KEY=YOUR_API_KEY_HERE

# How long a quote is reused before re-fetching (seconds). Free tiers are
# rate-limited, so don't set this too low.
VITE_STOCK_CACHE_TTL=60
